{
  "name": "ct-codex-translator",
  "version": "0.1.0",
  "description": "ihatejargons · 为每段 Codex 回复提供原文注释、简明改写和面向外行的简短讲解。",
  "type": "module",
  "keywords": [
    "codex-tweaks-package",
    "codex-tweaks-node"
  ],
  "codexTweaks": {
    "apiVersion": 3,
    "entrypoints": {
      "renderer": "src/index.js",
      "node": "src/backend.js"
    },
    "priority": 100,
    "packageDependencies": {},
    "permissions": {
      "node": {
        "reason": "读取 ~/.config/minicode/siliconflow.env 的 API 密钥；按所选服务向硅基流动或本机 Ollama 发送待译文字和必要前文。启用历史预译或手动预译聊天时，只读本机 Codex 聊天索引和会话文件，提取可见消息及公开摘要。在插件数据目录保存设置、词库和有容量上限的译文缓存。主动追问发送本词近期问答给硅基流动 DeepSeek。"
      }
    },
    "ui": {
      "settingsSections": {
        "apiVersion": 1,
        "required": false,
        "items": [
          {
            "id": "codex-translator",
            "title": "ihatejargons",
            "group": "personal",
            "icon": "personalization",
            "after": "personalization"
          }
        ]
      }
    }
  },
  "displayName": "ihatejargons",
  "repository": {
    "type": "git",
    "url": "https://github.com/sssn-tech/ihatejargons.git"
  }
}
